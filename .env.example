# Supabase (auth + quiz activity)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI
OPENAI_API_KEY=

# DeepSeek (used by scripts/deepseek-enrich.mjs and app/api/clea-chat)
DEEPSEEK_API_KEY=

# HeyGen
HEYGEN_API_KEY=

# Vercel (optional for OIDC)
VERCEL_OIDC_TOKEN=

# Supabase service role (admin operations, edge functions)
SUPABASE_SERVICE_ROLE_KEY=

# Wav2Lip lipsync server (defaults to ws://localhost:8765 in dev)
# Set to cloudflared/ngrok URL to use from Vercel prod: wss://clea-wav2lip.trycloudflare.com
NEXT_PUBLIC_WAV2LIP_WS_URL=
# Server-side HTTP counterpart of the same Wav2Lip server (used by API routes)
WAV2LIP_HTTP_URL=

# Cloudflare (tunnels, workers, API)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# Test user credentials (for development/e2e testing)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
