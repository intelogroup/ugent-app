# Supabase (auth + quiz activity + clea chat history)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (used by app/api/whisper-transcribe as primary transcription)
OPENAI_API_KEY=

# DeepSeek (used by scripts/deepseek-enrich.mjs and app/api/clea-chat)
DEEPSEEK_API_KEY=

# OpenRouter (fallback for scripts/deepseek-enrich.mjs)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ElevenLabs TTS (prod fallback for app/api/tts-audio, app/api/elevenlabs-tts)
ELEVENLABS_API_KEY=

# Wav2Lip lipsync server (dev-only; defaults to ws://localhost:8765)
# Set to cloudflared/ngrok URL to use from Vercel prod: wss://clea-wav2lip.trycloudflare.com
NEXT_PUBLIC_WAV2LIP_WS_URL=
# Server-side HTTP counterpart of the same Wav2Lip server (used by API routes)
WAV2LIP_HTTP_URL=

# Local dev-only voice servers (Kokoro/Piper TTS, whisper.cpp) — gated behind
# `!process.env.VERCEL`, unused in prod
LOCAL_KOKORO_URL=
LOCAL_PIPER_URL=
LOCAL_WHISPER_URL=

# Vercel Blob (data/*.jsonl fetched from Blob storage in prod instead of local FS)
BLOB_DATA_BASE_URL=

# Convex (legacy — kept only for scripts/*.ts migration/audit tooling, not read by the live app)
NEXT_PUBLIC_CONVEX_URL=
